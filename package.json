{
  "name": "anteros",
  "version": "0.1.0",
  "license": "MIT",
  "description": "QQ 群聊机器人：OneBot v11 接入、群聊记忆、工具能力与 Markdown 日报",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test --test-concurrency=2 test/*.test.ts",
    "sim": "node scripts/dev-sim.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "cheerio": "^1.0.0",
    "docx": "^9.10.0",
    "imapflow": "2.4.3",
    "ipaddr.js": "2.5.0",
    "jsdom": "30.1.2",
    "jszip": "3.10.1",
    "marked": "^18.1.1",
    "nodemailer": "10.1.1",
    "pdfjs-dist": "5.4.624",
    "pdfkit": "^0.20.2",
    "robots-parser": "3.0.1",
    "tinyld": "1.3.4",
    "turndown": "7.2.4",
    "undici": "7.30.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/turndown": "5.0.6",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
